{
  "name": "astrojs-atom",
  "description": "Add Atom feeds to your Astro projects",
  "keywords": [
    "astro-component",
    "utility",
    "atom",
    "rss"
  ],
  "version": "1.0.1",
  "type": "module",
  "types": "./dist/index.d.ts",
  "author": "flcdrg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flcdrg/astrojs-atom.git"
  },
  "homepage": "https://github.com/flcdrg/astrojs-atom",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest",
    "update-version": "node scripts/update-version.js",
    "prepublishOnly": "pnpm update-version && pnpm build",
    "get-version": "nbgv get-version",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": "eslint --fix",
    "*.{js,ts,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "26.1.2",
    "@types/xml2js": "^0.4.14",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "nerdbank-gitversioning": "3.10.91",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.17",
    "xml2js": "0.6.2"
  },
  "dependencies": {
    "astro": "^7.0.3",
    "fast-xml-builder": "^1.3.0",
    "fast-xml-parser": "^5.3.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
